group_by(Date, Site, Block, Treatment, Transect_Num, Obs_Code) |>
summarise(Abundance = ((n()/30)))
#Now lets combine the rest of the data
Transect_Analysis<-full_join(Transect_Data_Clean_Others,Transect_Data_Clean_2026)
unique(Transect_Analysis$Obs_Code)
#pending a check, data is fully ready to be analyzed
#Need to check which species are native and which are invasive
Plant_species <- (unique(Transect_Analysis$Obs_Code))
Species_List <- read_excel("Winter 2026 Veg Cover Raw Data.xlsx",
sheet = "Alphabetical by species code",
skip = 1)
Species_List <- Species_List |>
rename(Obs_Code = '....1')
Plant_species <- as.data.frame(Plant_species)
Plant_species <- Plant_species |>
rename(Obs_Code = 'Plant_species')
Checklist <- inner_join(Plant_species, Species_List, by = "Obs_Code")
unique(Checklist$....2)
#Now that we have a list, I need to look up the species below to see if they are fire resistant
#Had to do data cleaning ON EXCEL, like ALOT
head(Checklist)
Checklist <- Checklist |>
rename(Scientific_Name ='....2',
Status ='....3',
Common_Name = '....4',
Fire_Resistant = '...5',
Drought_Tolerance = '...6',
Family = '....8')
Checklist <- Checklist |>
mutate(Fire_Resistant = case_when(Status == "Non-Native" ~ "FV",
TRUE ~ Fire_Resistant)) |>
mutate(Drought_Tolerance = case_when(Status == "Non-Native" ~ "DV",
TRUE ~ Drought_Tolerance))
#Checklist is cleaned, now time to combine
Analysis_Full <- full_join(Transect_Analysis, Checklist)
#Now I want to remove all of the abiotic factors
unique(Analysis_Full$Obs_Code)
Analysis_Full<-Analysis_Full |>
mutate(Obs_Code = case_when(Obs_Code == "Non Native Grass Species" ~ "Unknown",
Obs_Code == "CALMAC?" ~ "Unknown",
Obs_Code == "UNKNNGRASS" ~ "Unknown",
TRUE ~ Obs_Code))
unique(Analysis_Full$Obs_Code)
Analysis_Full_Biotic <- Analysis_Full |>
filter(Obs_Code != "Bare Ground",
Obs_Code != "Litter",
Obs_Code != "Rock",
Obs_Code != "Stem",
Obs_Code != "Cryptobiotic Crust",
Obs_Code != "Moss",
Obs_Code != "UNK Value",
Obs_Code != "Dead",
Obs_Code != "Thatch")
unique(Analysis_Full_Biotic$Obs_Code)
ggplot(Analysis_Full_Biotic)+
aes(x = Abundance)+
geom_histogram()
#Data does not look normal, may need to log transform it
ggplot(Analysis_Full_Biotic)+
aes(x = log(Abundance))+
geom_histogram()
ggplot(Analysis_Full_Biotic)+
aes(x = sqrt(Abundance))+
geom_histogram()
#Count data is not normal, will need to do a Poisson distribution
#Need to convert my predictors into factors
Analysis_Full_Biotic$Block <- as.factor(Analysis_Full_Biotic$Block)
Analysis_Full_Biotic$Transect_Num <- as.factor(Analysis_Full_Biotic$Transect_Num)
#Poisson_Model_Biotic <- glm(Abundance ~ Treatment * Obs_Code * Status * Fire_Resistant * Drought_Tolerance + (1| Site/Block), data = Analysis_Full_Biotic,
#     family = poisson(link = "log"))
#Poisson is not an option because I did not do raw counts, I changed them into a continuous variable
Model_Biotic_Q1 <- lmer(Abundance ~ Treatment * Status + Obs_Code + Fire_Resistant + Drought_Tolerance + (1| Site/Block), data = Analysis_Full_Biotic)
plot(Model_Biotic_Q1)
#The data is super right skewed...
ggqqplot(residuals(Model_Biotic_Q1))
#Data is right skewed
Model_Biotic_Q1_Log <- lmer(log(Abundance) ~ Treatment * Status + Obs_Code + Fire_Resistant + Drought_Tolerance + (1| Site/Block), data = Analysis_Full_Biotic)
plot(Model_Biotic_Q1_Log)
ggqqplot(residuals(Model_Biotic_Q1_Log))
#The Log transformation looks better
#Levene's Test?
summary(Model_Biotic_Q1_Log)
anova(Model_Biotic_Q1_Log)
#This makes sense, there is a big difference between Obs_Code (Species) but not between treatments
#Going to try to put species as a random effect
Model_Biotic_Q1_2 <- lmer(Abundance ~ Treatment * Status + Fire_Resistant + Drought_Tolerance + (1| Site/Block) + (1| Obs_Code), data = Analysis_Full_Biotic)
plot(Model_Biotic_Q1_2)
ggqqplot(residuals(Model_Biotic_Q1_2))
summary(Model_Biotic_Q1_2)
anova(Model_Biotic_Q1_2)
#With this model there is no statistical significance
#Post HOC test?
#Could try a Gamma distribution, since the data is right skewed
library(glmmTMB)
#library(car)
Gamma_Model_Biotic_Q1 <- glmmTMB(Abundance ~ Treatment * Status + Fire_Resistant + Drought_Tolerance + (1| Site/Block) + (1| Obs_Code), data = Analysis_Full_Biotic,
family = Gamma(link="log"))
summary(Gamma_Model_Biotic_Q1)
ggqqplot(residuals(Gamma_Model_Biotic_Q1))
#This does not look better then the Log
#Looks almost exactlty the same
car::Anova(Gamma_Model_Biotic_Q1, type = 3)
ggqqplot(residuals(Model_Biotic_Q1_Log))
plot(Model_Biotic_Q1_Log)
Model_Biotic_Q1 <- lmer(Abundance ~ Treatment * Status + Obs_Code + Fire_Resistant + Drought_Tolerance + (1| Site/Block), data = Analysis_Full_Biotic)
Model_Biotic_Q1_Log2 <- lmer(log(Abundance) ~ Treatment * Status +  Fire_Resistant + Drought_Tolerance + (1| Site/Block)+(1| Obs_Code), data = Analysis_Full_Biotic)
plot(Model_Biotic_Q1_Log2)
ggqqplot(residuals(Model_Biotic_Q1_Log2))
