library(tidyverse)
library(googlesheets4)
library(readxl)
library(knitr)
library(ggpubr)
library(lme4)
library(lmerTest)
library(emmeans)
Size_data_raw <- read_excel("DroughtNet_MCRS_Fall2025.xlsx",
sheet = "ShrubSize")
#The data needs to be cleaned to convert plant heights to numeric, change some data titles, and to clean up some NAs
Size_data_raw_1 <- Size_data_raw[-1, ]
#This removes the first row that contains all the instructions
# Thing to fix #2 - turn Shrub_Height Column into a numeric, first have to remove the NO SHRUB rows
Size_data_raw_1 <- Size_data_raw_1 %>%
filter(Shrub_Height != "NO SHRUB") %>%
filter(Shrub_Height != "N/A") %>%
filter(!is.na(Shrub_Height))
#this cleans up all the shrub height data, giving me only numerical values
Size_data_raw_1 <- Size_data_raw_1 %>%
mutate(Shrub_Height = as.numeric(Shrub_Height))
#changes the column from character to numeric
summary(Size_data_raw_1$Shrub_Height)
Size_data_raw_1<-Size_data_raw_1 %>%
rename(Shrub_Height_mm = Shrub_Height)
Size_data_raw_1<-Size_data_raw_1 %>%
mutate(Seed_Source = case_when(Species == "BACPIL" ~ "M",
.default = Seed_Source))
#mutate and case_when lets me change all the values of BACPIL to M while keeping the other values unchanged
####NEED TO DROP BACPIL from HEIGHT!
#Height~WT x seedsource x species + blocking
Size_data_raw_1<-Size_data_raw_1 %>%
rename(Plot_Seed_Source = Seed_Source) %>%
rename(Plot_Water_Treatment = Water_Treatment)
#Should be ready to bind rows now, but will hold off until im fully done with data cleanup
#Thing to fix #4 - Fix water treatment misinputted values
Size_data_raw_1 <- Size_data_raw_1 %>%
mutate(Plot_Water_Treatment = case_when(Plot_Water_Treatment == "SR" ~ "RS",
Plot_Water_Treatment == "C" ~ "A",
.default = Plot_Water_Treatment)) %>%
filter(!is.na(Plot_Water_Treatment)) %>%
filter(!is.na(Shrub_Height_mm))
#Combining mutate and case_when lets me fix all the misinpputed values, bringing them all to RS, A, and WA.
Size_data_raw_2 <- Size_data_raw_1 %>%
select(Block_Number, Plot_Number, Plot_Water_Treatment, Plot_Seed_Source, Species, Shrub_Height_mm, Shrub_Width) %>%
filter(Species != "BACPIL") %>%
filter(Species != "ENCAL")
Paper_Analysis <- Size_data_raw_2 %>%
select(-Shrub_Width, -Plot_Number) %>%
filter(Plot_Seed_Source != "C") %>%
filter(!is.na(Plot_Seed_Source))
nrow(Paper_Analysis[Paper_Analysis$Plot_Water_Treatment == "WA", ])
nrow(Paper_Analysis[Paper_Analysis$Species == "SALMEL", ])
ggplot(Paper_Analysis)+
aes(x = log(Shrub_Height_mm))+
geom_histogram()
ggplot(Paper_Analysis)+
aes(x = Plot_Water_Treatment, y = log(Shrub_Height_mm), fill = Species)+
geom_boxplot()
#Will test square root transformations.
ggplot(Paper_Analysis)+
aes(x = sqrt(Shrub_Height_mm))+
geom_histogram()
ggplot(Paper_Analysis)+
aes(x = Plot_Water_Treatment, y = sqrt(Shrub_Height_mm), fill = Species)+
geom_boxplot()
#Square root looks like it might be better
Paper_Model  <- lmer(log(Shrub_Height_mm) ~ Plot_Water_Treatment * Species * Plot_Seed_Source+(1|Block_Number), data = Paper_Analysis)
plot(Paper_Model, which = 2)
#Data looks pretty normal!
ggqqplot(residuals(Paper_Model))
Paper_Model2  <- lmer(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species * Plot_Seed_Source+(1|Block_Number), data = Paper_Analysis)
plot(Paper_Model2, which = 2)
#Data looks pretty normal!
ggqqplot(residuals(Paper_Model2))
#it appears that when I square root transform the data, the points are mostly within the grey area. Making it closer to normal
#Will proceed with square root transformed data from now on
plot(Paper_Model2, which = 1)
#Need to convert Block_Number into a factor in order to use Levene's Test.
Paper_Analysis <- Paper_Analysis %>%
mutate(Block_Number = as.factor(Block_Number))
#Paper_Analysis %>%
# rstatix::levene_test(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species * Plot_Seed_Source + Block_Number)
#This does not work, need to take Block_Number out or do it by block_Number
Paper_Analysis %>%
rstatix::levene_test(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species * Plot_Seed_Source)
Paper_Anova_Test <- lmer(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species * Plot_Seed_Source + (1|Block_Number), data = Paper_Analysis)
summary(Paper_Anova_Test)
anova(Paper_Anova_Test, type = "II")
#going to drop seed source and species from the interactions
Paper_Anova_Test2 <- lmer(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species + Plot_Seed_Source * Species + (1|Block_Number), data = Paper_Analysis)
anova(Paper_Anova_Test2, type = "II")
#need to use the emmeans package to use Tukey's Test with the mixed model.
emmeans(Paper_Anova_Test2, pairwise ~ Plot_Water_Treatment, adjust = "tukey")
#WA was statistically different then both ambient and rain shelter
emmeans(Paper_Anova_Test2, pairwise ~ Plot_Water_Treatment*Species, adjust = "tukey")
#This shows the statistical differences in comparisons, will analyze later
emmeans(Paper_Anova_Test2, pairwise ~ Species*Plot_Seed_Source, adjust = "tukey")
#This shows the statistical differences in comparisons, will analyze later
Paper_Analysis_Summary <- Paper_Analysis %>%
group_by(Plot_Water_Treatment, Species, Plot_Seed_Source) %>%
summarise(
Mean_Height = mean(Shrub_Height_mm),
se = sd(Shrub_Height_mm)/ sqrt(length(Shrub_Height_mm)))
Paper_Analysis_Summary
ggplot(Paper_Analysis_Summary) +
aes(x = Plot_Water_Treatment, y = Mean_Height, fill = Species) +
geom_col(position = "dodge") +
geom_errorbar(aes(ymin = Mean_Height - se, ymax = Mean_Height + se), position = position_dodge(0.9), width = 0.2)+
facet_wrap(Plot_Seed_Source ~.)+
theme_bw()
Water_Treatment_Sum <- Paper_Analysis %>%
group_by(Plot_Water_Treatment) %>%
summarise(
Mean_Height = mean(Shrub_Height_mm),
se = sd(Shrub_Height_mm)/ sqrt(length(Shrub_Height_mm))) %>%
mutate(Plot_Water_Treatment = case_when(Plot_Water_Treatment == "WA" ~ "Water Added",
Plot_Water_Treatment == "A" ~ "Ambient",
Plot_Water_Treatment == "RS" ~ "Rain Shelter"))
Water_Treatment_Sum$Plot_Water_Treatment <- factor(Water_Treatment_Sum$Plot_Water_Treatment,
c("Rain Shelter", "Ambient", "Water Added"))
emmeans(Paper_Anova_Test, pairwise ~ Plot_Water_Treatment, adjust = "tukey")
#From Tukey's, we know that WA is statistically different from RS and A. RS and A are not statistically different from one another
ggplot(Water_Treatment_Sum) +
aes(x = Plot_Water_Treatment, y = Mean_Height, fill = Plot_Water_Treatment) +
geom_col() +
geom_errorbar(aes(ymin = (Mean_Height - se), ymax = (Mean_Height + se)), width = 0.2) +
geom_text( label = c("B", "B", "A"),
aes(y = Mean_Height+se, x = Plot_Water_Treatment),
vjust = -1,
size = 3) +
ylim(0, 120)+
labs(x = "Water Treatment", y = "Mean Height (cm)", fill = "Water Treatment")+
theme_bw()+
theme(legend.position = "none") +
scale_fill_manual(values = c("#8B4513", "#228B22", "#1E90FF"))
