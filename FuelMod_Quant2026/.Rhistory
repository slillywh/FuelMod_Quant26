Paper_Anova_Test <- lmer(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species * Plot_Seed_Source + (1|Block_Number), data = Paper_Analysis)
summary(Paper_Anova_Test)
anova(Paper_Anova_Test, type = "II")
#going to drop seed source and species from the interactions
Paper_Anova_Test2 <- lmer(sqrt(Shrub_Height_mm) ~ Plot_Water_Treatment * Species + Plot_Seed_Source * Species + (1|Block_Number), data = Paper_Analysis)
anova(Paper_Anova_Test2, type = "II")
#need to use the emmeans package to use Tukey's Test with the mixed model.
emmeans(Paper_Anova_Test2, pairwise ~ Plot_Water_Treatment, adjust = "tukey")
#WA was statistically different then both ambient and rain shelter
emmeans(Paper_Anova_Test2, pairwise ~ Plot_Water_Treatment*Species, adjust = "tukey")
#This shows the statistical differences in comparisons, will analyze later
emmeans(Paper_Anova_Test2, pairwise ~ Species*Plot_Seed_Source, adjust = "tukey")
#This shows the statistical differences in comparisons, will analyze later
Paper_Analysis_Summary <- Paper_Analysis %>%
group_by(Plot_Water_Treatment, Species, Plot_Seed_Source) %>%
summarise(
Mean_Height = mean(Shrub_Height_mm),
se = sd(Shrub_Height_mm)/ sqrt(length(Shrub_Height_mm)))
Paper_Analysis_Summary
ggplot(Paper_Analysis_Summary) +
aes(x = Plot_Water_Treatment, y = Mean_Height, fill = Species) +
geom_col(position = "dodge") +
geom_errorbar(aes(ymin = Mean_Height - se, ymax = Mean_Height + se), position = position_dodge(0.9), width = 0.2)+
facet_wrap(Plot_Seed_Source ~.)+
theme_bw()
Water_Treatment_Sum <- Paper_Analysis %>%
group_by(Plot_Water_Treatment) %>%
summarise(
Mean_Height = mean(Shrub_Height_mm),
se = sd(Shrub_Height_mm)/ sqrt(length(Shrub_Height_mm))) %>%
mutate(Plot_Water_Treatment = case_when(Plot_Water_Treatment == "WA" ~ "Water Added",
Plot_Water_Treatment == "A" ~ "Ambient",
Plot_Water_Treatment == "RS" ~ "Rain Shelter"))
Water_Treatment_Sum$Plot_Water_Treatment <- factor(Water_Treatment_Sum$Plot_Water_Treatment,
c("Rain Shelter", "Ambient", "Water Added"))
emmeans(Paper_Anova_Test, pairwise ~ Plot_Water_Treatment, adjust = "tukey")
#From Tukey's, we know that WA is statistically different from RS and A. RS and A are not statistically different from one another
ggplot(Water_Treatment_Sum) +
aes(x = Plot_Water_Treatment, y = Mean_Height, fill = Plot_Water_Treatment) +
geom_col() +
geom_errorbar(aes(ymin = (Mean_Height - se), ymax = (Mean_Height + se)), width = 0.2) +
geom_text( label = c("B", "B", "A"),
aes(y = Mean_Height+se, x = Plot_Water_Treatment),
vjust = -1,
size = 3) +
ylim(0, 120)+
labs(x = "Water Treatment", y = "Mean Height (cm)", fill = "Water Treatment")+
theme_bw()+
theme(legend.position = "none") +
scale_fill_manual(values = c("#8B4513", "#228B22", "#1E90FF"))
WaterSpecies_Sum <- Paper_Analysis %>%
group_by(Plot_Water_Treatment, Species) %>%
summarise(
Mean_Height = mean(Shrub_Height_mm),
se = sd(Shrub_Height_mm)/ sqrt(length(Shrub_Height_mm))) %>%
mutate(Plot_Water_Treatment = case_when(Plot_Water_Treatment == "WA" ~ "Water Added",
Plot_Water_Treatment == "A" ~ "Ambient",
Plot_Water_Treatment == "RS" ~ "Rain Shelter"))
WaterSpecies_Sum$Plot_Water_Treatment <- factor(WaterSpecies_Sum$Plot_Water_Treatment,
c("Rain Shelter", "Ambient", "Water Added"))
ggplot(WaterSpecies_Sum) +
aes(x = Plot_Water_Treatment, y = Mean_Height, fill = Species) +
geom_col(position = "dodge") +
geom_errorbar(aes(ymin = Mean_Height - se, ymax = Mean_Height + se), position = position_dodge(0.9), width = 0.2)+
theme_bw()+
scale_fill_manual(values = c("#1E90FF", "#E63946"))
emmeans(Paper_Anova_Test2, pairwise ~ Plot_Water_Treatment*Species, adjust = "tukey")
#This shows the statistical differences in comparisons, will analyze later
ggplot(WaterSpecies_Sum) +
aes(x = Plot_Water_Treatment, y = Mean_Height, fill = Species) +
geom_col(position = "dodge") +
geom_errorbar(aes(ymin = Mean_Height - se, ymax = Mean_Height + se), position = position_dodge(0.9), width = 0.2)+
geom_text(
label = c("BC", "BC", "B", "C", "B", "A"),
position = position_dodge(0.9),
aes(y = Mean_Height+se, x = Plot_Water_Treatment),
vjust = -0.5,
size = 6) +
ylim(0, 150)+
theme_bw()+
labs(x = "Water Treatment", y = "Mean Height (cm)")+
scale_fill_manual(values = c("#1E90FF", "#E63946"))
SeedSpecies_Sum <- Paper_Analysis %>%
group_by(Plot_Seed_Source, Species) %>%
summarise(
Mean_Height = mean(Shrub_Height_mm),
se = sd(Shrub_Height_mm)/ sqrt(length(Shrub_Height_mm))) %>%
mutate(Plot_Seed_Source = case_when(Plot_Seed_Source == "M" ~ "Mesic",
Plot_Seed_Source == "X" ~ "Xeric",
)) %>%
rename(`Seed Source` = Plot_Seed_Source)
ggplot(SeedSpecies_Sum) +
aes(x = Species, y = Mean_Height, fill = `Seed Source`) +
geom_col(position = "dodge") +
geom_errorbar(aes(ymin = Mean_Height - se, ymax = Mean_Height + se), position = position_dodge(0.9), width = 0.2)+
theme_bw()+
scale_fill_manual(values = c("#1E90FF", "#E63946"))
emmeans(Paper_Anova_Test2, pairwise ~ Species*Plot_Seed_Source, adjust = "tukey")
#This shows the statistical differences in comparisons, will analyze later
ggplot(SeedSpecies_Sum) +
aes(x = Species, y = Mean_Height, fill = `Seed Source`) +
geom_col(position = "dodge") +
geom_errorbar(aes(ymin = Mean_Height - se, ymax = Mean_Height + se), position = position_dodge(0.9), width = 0.2)+
geom_text(
label = c("AB", "A", "A", "B"),
position = position_dodge(0.9),
aes(y = Mean_Height+se, x = Species),
vjust = -0.5,
size = 6) +
ylim(0, 150)+
theme_bw()+
labs(x = "Species", y = "Mean Height (cm)")+
scale_fill_manual(values = c("#1E90FF", "brown"))
